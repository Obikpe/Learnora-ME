# Local Learnora backend defaults. Platform environment variables override this file.
APP_ENV=development

# Temporary Learnora ME individual-learner free launch (server-side only).
# Set true in the backend deployment environment to enable; false restores billing gates.
FREE_ACCESS_MODE=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Local frontends (Learnora ME :3000, Learnora Teams :3001)
INTERNAL_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Learnora AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LEARNORA_AI_REFERER=http://localhost:3000

# Transactional email — Gmail API over HTTPS (no SMTP, Resend, or custom domain).
# Create these credentials using docs/GMAIL_API_SETUP.md.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
# Optional: must be the Gmail account address or a verified Gmail send-as alias.
GMAIL_FROM_EMAIL=
GMAIL_FROM_NAME=Learnora Me
