# Local Learnora backend defaults. Platform environment variables override this file.
APP_ENV=development

# Temporary Learnora ME individual-learner free launch (server-side only).
# Set true in the backend deployment environment to enable; false restores billing gates.
FREE_ACCESS_MODE=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Local frontends (Learnora ME :3000, Learnora Teams :3001)
INTERNAL_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Learnora AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LEARNORA_AI_REFERER=http://localhost:3000

# Transactional email (Gmail SMTP). Use a Google App Password, not your
# normal Google account password. Configure these in Vercel backend env vars.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Learnora Me

# Optional legacy fallback; Gmail SMTP takes priority when configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Learnora Me
