{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "runtime": "vercel-python@4.2.0"
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/account-lifecycle/finalize-expired",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/notifications/process-automation",
      "schedule": "0 8 * * *"
    }
  ]
}
