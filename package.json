{
  "name": "the-pheonix-analytics-monorepo",
  "version": "2.0.1-secure-fix",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:me\" \"npm run dev:backend\"",
    "dev:me": "cd frontend-v02 && npm run dev",
    "dev:teams": "cd frontend-team && npm run dev -- --port 3001",
    "dev:backend": "cd backend-python && uvicorn main:app --reload --port 8000",
    "build:me": "cd frontend-v02 && npm run build",
    "build:teams": "cd frontend-team && npm run build",
    "install:all": "npm install && cd frontend-v02 && npm install && cd ../frontend-team && npm install && cd ../backend-python && python -m pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.26.0"
  }
}
